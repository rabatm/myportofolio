# Mistral API key: Marvin-42 chatbot and spam check of the contact form
# Get yours at https://console.mistral.ai
MISTRAL_API_KEY=

# SMTP pour le formulaire de contact (les messages sont envoyés par email)
# Gmail : SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, et un mot de passe
# d'application (https://myaccount.google.com/apppasswords, 2FA requise)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Destinataire des messages (par défaut : SMTP_USER)
CONTACT_TO=
