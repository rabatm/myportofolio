---
import { Picture } from 'astro:assets';
import martin from '../../assets/martin.png';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import Temoignages from '../sections/Temoignages.astro';
import { approche, tempsForts } from '../../data/about';
import { pageLines } from '../../data/marvinLines';
import { t } from '../../i18n/ui';
import { buildPath } from '../../i18n/utils';
import type { Lang } from '../../i18n/utils';

export interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const d = t(lang);
// Faits : src/data/about.ts (tirés de parcours.ts, temoignages.ts et de la
// spec). Le clin d'œil au jeu caché ne le nomme ni ne le décrit.
---

<BaseLayout
  lang={lang}
  title={d['about.title']}
  description={d['about.description']}
  peekLines={pageLines[lang].about}
>
  <section class="container-wide pt-32 pb-16">
    <div class="about-hero">
      <div class="about-photo">
        <Picture
          src={martin}
          alt="Martin Rabat"
          widths={[240, 360, 480, 720]}
          sizes="(min-width: 768px) 320px, 240px"
          formats={['avif']}
          fallbackFormat="webp"
          loading="eager"
          decoding="async"
          class="w-full h-full object-cover"
          style="object-position: center 15%;"
        />
      </div>
      <div class="max-w-2xl">
        <SectionHeading level={1} kicker={d['about.kicker']} title={d['about.heading']} intro={d['about.intro']} />
      </div>
    </div>
  </section>

  <section class="py-16 md:py-20" style="background: var(--surface-muted);" aria-labelledby="about-approach">
    <div class="container-wide">
      <SectionHeading id="about-approach" kicker={d['about.approachKicker']} title={d['about.approachTitle']} />
      <ul class="approach-grid">
        {approche[lang].map((a) => (
          <li class="approach-card">
            <h3 class="approach-title">{a.title}</h3>
            <p>{a.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="py-16 md:py-20" aria-labelledby="about-path">
    <div class="container-wide">
      <SectionHeading id="about-path" kicker={d['about.pathKicker']} title={d['about.pathTitle']} />
      <ol class="path-list">
        {tempsForts[lang].map((tf) => (
          <li class="path-item">
            <p class="path-period">{tf.periode}</p>
            <h3 class="path-title">{tf.title}</h3>
            <p>{tf.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <Temoignages lang={lang} />

  <section class="py-16 md:py-20" aria-labelledby="about-fun">
    <div class="container-wide">
      <div class="max-w-3xl">
        <SectionHeading id="about-fun" kicker={d['about.funKicker']} title={d['about.fun']} />
        <p class="fun-text">
          {d['about.funText']}
          {' '}
          <a href={buildPath('projects', lang, 'cleo')}>{d['about.funCleoLink']}</a>
        </p>
        <p class="fun-game">{d['about.funGame']}</p>
      </div>
    </div>
  </section>

  <section class="surface-dark py-16 md:py-20">
    <div class="container-wide">
      <div class="max-w-3xl">
        <h2 class="heading-2">{d['about.ctaTitle']}</h2>
        <p class="mt-8">
          <a href={buildPath('contact', lang)} class="btn-primary">{d['about.cta']}</a>
        </p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .about-hero {
    display: grid;
    gap: 2.5rem;
    align-items: center;
  }
  @media (min-width: 768px) {
    .about-hero {
      grid-template-columns: 320px minmax(0, 1fr);
      gap: 4rem;
    }
  }
  .about-photo {
    width: 240px;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: 8px;
    border: 1px solid var(--border);
    background: var(--surface-muted);
  }
  @media (min-width: 768px) {
    .about-photo {
      width: 320px;
    }
  }
  .approach-grid {
    display: grid;
    gap: 1.25rem;
    margin: 2.5rem 0 0;
    padding: 0;
    list-style: none;
  }
  @media (min-width: 640px) {
    .approach-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 1024px) {
    .approach-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .approach-card {
    padding: 1.5rem;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--bg);
    line-height: 1.6;
    color: var(--ink-soft);
  }
  .approach-title,
  .path-title {
    margin: 0 0 0.5rem;
    font-size: 1.25rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    line-height: 1.3;
    color: var(--ink);
  }
  .path-list {
    display: grid;
    gap: 2rem;
    margin: 2.5rem 0 0;
    padding: 0;
    list-style: none;
  }
  @media (min-width: 900px) {
    .path-list {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 3rem;
    }
  }
  .path-item {
    padding-top: 1.25rem;
    border-top: 2px solid var(--ink);
    line-height: 1.6;
    color: var(--ink-soft);
  }
  .path-period {
    margin: 0 0 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.875rem;
    color: var(--accent-hover);
  }
  .fun-text,
  .fun-game {
    margin: 1.75rem 0 0;
    font-size: 1.0625rem;
    line-height: 1.6;
    color: var(--ink-soft);
  }
  .fun-text a {
    color: var(--accent-hover);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .fun-game {
    margin-top: 1rem;
    font-family: var(--font-mono);
    font-size: 0.9375rem;
  }
  .fun-game::before {
    content: '> ';
    content: '> ' / '';
    color: var(--accent-hover);
  }
</style>
