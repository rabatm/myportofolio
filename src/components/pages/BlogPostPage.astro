---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import OnlyInBadge from '../i18n/OnlyInBadge.astro';
import type { LocalizedPost } from '../../i18n/collections';
import { t } from '../../i18n/ui';
import { buildPath, formatDate, type Lang } from '../../i18n/utils';

export interface Props {
  lang: Lang;
  item: LocalizedPost;
}

const { lang, item } = Astro.props;
const d = t(lang);
const post = item.entry;
const { Content } = await render(post);
---

<BaseLayout
  lang={lang}
  title={`${post.data.title} ${d['post.titleSuffix']}`}
  description={post.data.description}
  contentLang={item.contentLang}
>
  <article class="container-wide pt-32 pb-20">
    <div class="max-w-3xl">
      <a href={buildPath('blog', lang)} class="post-back">{d['post.back']}</a>
      <p class="post-date">
        <time datetime={post.data.date.toISOString().slice(0, 10)}>{formatDate(post.data.date, lang)}</time>
      </p>
      {item.isFallback && <div><OnlyInBadge lang={lang} /></div>}
      <h1 class="heading-1" lang={item.contentLang}>{post.data.title}</h1>
      {post.data.tags.length > 0 && (
        <p class="post-tags">{post.data.tags.map((tag) => `#${tag}`).join(' ')}</p>
      )}
      <div class="prose max-w-none mt-10" style="color: var(--ink-soft);" lang={item.contentLang}>
        <Content />
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .post-back {
    display: inline-block;
    margin-bottom: 2rem;
    font-family: var(--font-mono);
    font-size: 0.875rem;
    color: var(--accent-hover);
  }
  .post-date {
    margin: 0 0 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--ink-faint);
  }
  .post-tags {
    margin: 1rem 0 0;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--ink-faint);
  }
</style>
