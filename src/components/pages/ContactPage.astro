---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContactForm from '../contact/ContactForm.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import { CONTACT_EMAIL } from '../../data/site';
import { t } from '../../i18n/ui';
import type { Lang } from '../../i18n/utils';

export interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const d = t(lang);
---

<BaseLayout
  lang={lang}
  title={d['contact.title']}
  description={d['contact.description']}
>
  <section class="container-wide pt-32 pb-20">
    <div class="max-w-3xl">
      <SectionHeading
        level={1}
        kicker={d['contact.kicker']}
        title={d['contact.heading']}
        intro={d['contact.intro']}
      />
    </div>

    <div class="mt-12 grid gap-10 md:grid-cols-[minmax(0,1fr)_minmax(0,2fr)] md:gap-16 items-start">
      <div class="md:pt-8">
        <p class="kicker">{d['contact.direct']}</p>
        <a
          href={`mailto:${CONTACT_EMAIL}`}
          class="font-mono text-base underline underline-offset-4 break-all"
          style="color: var(--ink);"
        >
          {CONTACT_EMAIL}
        </a>
      </div>
      <div class="p-6 sm:p-8 rounded-lg" style="background: var(--card-bg); border: 1px solid var(--border);">
        <ContactForm lang={lang} idPrefix="contact" />
      </div>
    </div>
  </section>
</BaseLayout>
