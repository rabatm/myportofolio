---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../sections/Hero.astro';
import IlsMeFontConfiance from '../sections/IlsMeFontConfiance.astro';
import ServicesApercu from '../sections/ServicesApercu.astro';
import RealisationsUne from '../sections/RealisationsUne.astro';
import Methode from '../sections/Methode.astro';
import Temoignages from '../sections/Temoignages.astro';
import Humain from '../sections/Humain.astro';
import ContactBloc from '../sections/ContactBloc.astro';
import { pageLines, sectionLines } from '../../data/marvinLines';
import { getLocalizedCollection } from '../../i18n/collections';
import { t } from '../../i18n/ui';
import type { Lang } from '../../i18n/utils';

export interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const d = t(lang);
const projects = await getLocalizedCollection('projects', lang);
---

<BaseLayout
  lang={lang}
  title={d['home.title']}
  description={d['home.description']}
  peekLines={pageLines[lang].home}
  sectionLines={sectionLines[lang]}
>
  <Hero lang={lang} />
  <IlsMeFontConfiance lang={lang} />
  <ServicesApercu lang={lang} />
  <RealisationsUne lang={lang} items={projects} />
  <Methode lang={lang} />
  <Temoignages lang={lang} />
  <Humain lang={lang} />
  <ContactBloc lang={lang} />
</BaseLayout>
