---
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';
import { initials } from '../../utils/projectImage';

export interface Props {
  image?: ImageMetadata;
  title: string;
}

const { image, title } = Astro.props;

// La carte fait au plus ~480 px de large (grille 2 colonnes), plein écran sur
// mobile. On n'agrandit jamais au-delà de l'original.
const LARGEURS = [400, 800, 1200];
const largeurs = image ? LARGEURS.filter((w) => w < image.width).concat(image.width) : [];
---

<div
  class="aspect-video mb-4 flex items-center justify-center overflow-hidden"
  style="background: var(--accent-soft); border: 1px solid var(--border);"
>
  {image ? (
    <Picture
      src={image}
      alt={title}
      widths={largeurs}
      sizes="(min-width: 768px) 480px, 100vw"
      formats={['avif']}
      fallbackFormat="webp"
      loading="lazy"
      decoding="async"
      class="w-full h-full object-cover"
    />
  ) : (
    <span class="text-4xl font-mono" style="color: var(--ink-faint);">
      {initials(title)}
    </span>
  )}
</div>
