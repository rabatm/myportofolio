---
import HeroIllustration from '../ui/HeroIllustration.astro';
import { t } from '../../i18n/ui';
import { buildPath } from '../../i18n/utils';
import type { Lang } from '../../i18n/utils';

export interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const d = t(lang);
---

<section id="hero" class="home-section pt-32 pb-16 md:pt-40 md:pb-24">
  <div class="container-wide hero-grid">
    <div>
      <p class="kicker">{d['home.heroKicker']}</p>
      <h1 class="heading-1 hero-title">{d['home.heroTitle']}</h1>
      <p class="heading-intro">{d['home.heroSub']}</p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href="#contact" class="btn-primary">{d['home.heroCta']}</a>
        <a href={buildPath('projects', lang)} class="btn-ghost">{d['home.heroCta2']}</a>
      </div>
      <p class="hero-where">{d['home.heroWhere']}</p>
    </div>
    <HeroIllustration label={d['home.heroIllustrationLabel']} />
  </div>
</section>

<style>
  .hero-grid {
    display: grid;
    gap: 2.5rem;
    align-items: center;
  }
  @media (min-width: 768px) {
    .hero-grid {
      grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
      gap: 3.5rem;
    }
  }
  .hero-title {
    margin-top: 0.25rem;
  }
  .hero-where {
    margin: 1.5rem 0 0;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--ink-faint);
  }
</style>
