---
import SectionHeading from '../ui/SectionHeading.astro';
import { methode } from '../../data/services';
import { t } from '../../i18n/ui';
import type { Lang } from '../../i18n/utils';

export interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const d = t(lang);
---

<section id="methode" class="home-section py-20 md:py-28">
  <div class="container-wide">
    <SectionHeading kicker={d['home.methodKicker']} title={d['home.methodTitle']} />
    <ol class="method-steps">
      {methode[lang].map((etape, i) => (
        <li class="method-step">
          <span class="method-step__num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          <h3 class="method-step__title">{etape.title}</h3>
          <p class="method-step__text">{etape.text}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .method-steps {
    display: grid;
    gap: 2rem;
    margin: 2.5rem 0 0;
    padding: 0;
    list-style: none;
  }
  @media (min-width: 640px) {
    .method-steps {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 1024px) {
    .method-steps {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
  .method-step {
    padding-top: 1rem;
    border-top: 2px solid var(--ink);
  }
  .method-step__num {
    display: block;
    margin-bottom: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.875rem;
    color: var(--accent-hover);
  }
  .method-step__title {
    margin: 0 0 0.4rem;
    font-size: 1.25rem;
    font-weight: 700;
  }
  .method-step__text {
    margin: 0;
    line-height: 1.55;
    color: var(--ink-soft);
  }
</style>
