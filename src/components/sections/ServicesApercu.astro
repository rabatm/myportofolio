---
import SectionHeading from '../ui/SectionHeading.astro';
import { services } from '../../data/services';
import { t } from '../../i18n/ui';
import { buildPath } from '../../i18n/utils';
import type { Lang } from '../../i18n/utils';

export interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const d = t(lang);
---

<section id="services" class="home-section py-20 md:py-28">
  <div class="container-wide">
    <SectionHeading
      kicker={d['home.servicesKicker']}
      title={d['home.servicesTitle']}
      intro={d['home.servicesIntro']}
    />
    <ul class="services-grid">
      {services[lang].map((s) => (
        <li>
          <a href={buildPath('services', lang, undefined, `#${s.id}`)} class="service-card">
            <p class="kicker service-card__name">{s.name}</p>
            <h3 class="service-card__hook">{s.hook}</h3>
            <span class="service-card__arrow" aria-hidden="true">→</span>
          </a>
        </li>
      ))}
    </ul>
    <p class="mt-8">
      <a href={buildPath('services', lang)} class="btn-ghost">{d['home.servicesAll']}</a>
    </p>
  </div>
</section>

<style>
  .services-grid {
    display: grid;
    gap: 1rem;
    margin: 2.5rem 0 0;
    padding: 0;
    list-style: none;
  }
  @media (min-width: 640px) {
    .services-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 1024px) {
    .services-grid {
      grid-template-columns: repeat(5, minmax(0, 1fr));
    }
  }
  .service-card {
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 1.25rem;
    background: var(--card-bg);
    border: 1px solid var(--border);
    border-radius: 8px;
    color: var(--ink);
    text-decoration: none;
    transition: border-color 0.15s ease, transform 0.15s ease;
  }
  .service-card:hover {
    border-color: var(--ink);
    transform: translateY(-2px);
  }
  .service-card:focus-visible {
    outline: 2px solid var(--accent-hover);
    outline-offset: 3px;
  }
  .service-card__name {
    margin-bottom: 0.5rem;
  }
  .service-card__hook {
    margin: 0 0 1rem;
    font-size: 1.125rem;
    font-weight: 700;
    line-height: 1.3;
    letter-spacing: -0.01em;
  }
  .service-card__arrow {
    margin-top: auto;
    font-family: var(--font-mono);
    color: var(--accent-hover);
  }
  @media (prefers-reduced-motion: reduce) {
    .service-card {
      transition: none;
    }
    .service-card:hover {
      transform: none;
    }
  }
</style>
