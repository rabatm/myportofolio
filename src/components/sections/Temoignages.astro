---
import { temoignages } from '../../data/temoignages';
import { t } from '../../i18n/ui';
import type { Lang } from '../../i18n/utils';

export interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const d = t(lang);
---

<section id="temoignages" class="px-4 py-20 max-w-3xl mx-auto">
  <div class="carousel" data-current="0">
    <div class="carousel-header">
      <h2 class="section-title">{d['testimonials.title']}</h2>
      <div class="carousel-nav">
        <button class="carousel-btn prev" aria-label={d['testimonials.prev']}>◀</button>
        <button class="carousel-btn next" aria-label={d['testimonials.next']}>▶</button>
      </div>
    </div>
    <div class="carousel-track">
      {temoignages[lang].map((item, i) => (
        <div class="carousel-slide" data-index={i}>
          <div class="quote-box">
            <div class="quote-collapse" data-expanded="false">
              <p class="quote-text">"{item.quote}"</p>
              <div class="quote-fade"></div>
            </div>
            <button class="quote-toggle" aria-label={d['testimonials.moreAria']} data-more={d['testimonials.more']} data-less={d['testimonials.less']}>{d['testimonials.more']}</button>
          </div>
          <p class="quote-author">— {item.name}</p>
          <p class="quote-title">{item.title}</p>
          <p class="quote-company">{item.company}</p>
        </div>
      ))}
    </div>

    <div class="carousel-dots">
      {temoignages[lang].map((_, i) => (
        <span class="carousel-dot" data-index={i}></span>
      ))}
    </div>
    {d['testimonials.translated'] && (
      <p class="quote-translated">{d['testimonials.translated']}</p>
    )}
  </div>
</section>

<script>
  const carousel = document.querySelector('.carousel') as HTMLElement | null;
  if (carousel) {
    const track = carousel.querySelector('.carousel-track') as HTMLElement;
    const slides = track.querySelectorAll('.carousel-slide');
    const dots = carousel.querySelectorAll('.carousel-dot');
    const prev = carousel.querySelector('.prev') as HTMLElement;
    const next = carousel.querySelector('.next') as HTMLElement;
    let current = 0;
    let interval: ReturnType<typeof setInterval>;

    function goTo(index: number) {
      current = index;
      track.style.transform = `translateX(-${current * 100}%)`;
      carousel.setAttribute('data-current', String(current));
      dots.forEach((d, i) => d.classList.toggle('active', i === current));
    }

    function nextSlide() { goTo((current + 1) % slides.length); }
    function prevSlide() { goTo((current - 1 + slides.length) % slides.length); }

    prev.addEventListener('click', () => { prevSlide(); resetAuto(); });
    next.addEventListener('click', () => { nextSlide(); resetAuto(); });
    dots.forEach(d => d.addEventListener('click', () => { goTo(Number((d as HTMLElement).dataset.index)); resetAuto(); }));

    carousel.addEventListener('mouseenter', () => clearInterval(interval));
    carousel.addEventListener('mouseleave', () => { interval = setInterval(nextSlide, 8000); });

    function resetAuto() {
      clearInterval(interval);
      interval = setInterval(nextSlide, 8000);
    }

    goTo(0);
    interval = setInterval(nextSlide, 8000);
  }

  // Quote collapse toggle — pause auto-rotation
  document.querySelectorAll('.quote-toggle').forEach(btn => {
    btn.addEventListener('click', () => {
      const collapse = btn.previousElementSibling as HTMLElement;
      const expanded = collapse.dataset.expanded === 'true';
      collapse.dataset.expanded = expanded ? 'false' : 'true';
      const b = btn as HTMLElement;
      b.textContent = (expanded ? b.dataset.more : b.dataset.less) ?? '';
      // pause auto-rotation when expanded
      if (!expanded) clearInterval(interval);
    });
  });
</script>

<style>
  .carousel {
    position: relative;
    overflow: hidden;
  }
  .carousel-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1rem;
  }
  .carousel-header .section-title {
    margin: 0;
  }
  .carousel-nav {
    display: flex;
    gap: 0.5rem;
  }
  .carousel-track {
    display: flex;
    transition: transform 0.4s ease;
  }
  .carousel-slide {
    min-width: 100%;
    box-sizing: border-box;
    text-align: center;
    padding: 1rem 0;
  }
  .quote-box {
    border: 2px solid var(--border);
    border-radius: 20px;
    padding: 1.5rem 1.5rem 0.75rem;
    margin-bottom: 1rem;
    background: var(--card-bg);
    position: relative;
  }
  .quote-collapse {
    position: relative;
    max-height: 7em;
    overflow: hidden;
    transition: max-height 0.3s ease;
  }
  .quote-collapse[data-expanded="true"] {
    max-height: none;
  }
  .quote-toggle {
    background: none;
    border: none;
    color: var(--accent-hover);
    font-family: monospace;
    font-size: 0.8rem;
    cursor: pointer;
    text-decoration: underline;
    text-underline-offset: 2px;
    margin-top: 0.25rem;
    padding: 0;
    opacity: 0.7;
    transition: opacity 0.2s;
    display: block;
  }
  .quote-toggle:hover {
    opacity: 1;
  }
  .quote-fade {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 2.5em;
    background: linear-gradient(transparent, var(--card-bg));
    pointer-events: none;
  }
  .quote-collapse[data-expanded="true"] .quote-fade {
    display: none;
  }
  .quote-box::before {
    content: '╔══ ';
    color: var(--accent);
    position: absolute;
    top: 0.3rem;
    left: 0.5rem;
    font-family: monospace;
    font-size: 0.75rem;
  }
  .quote-box::after {
    content: ' ══╗';
    color: var(--accent);
    position: absolute;
    bottom: 0.3rem;
    right: 0.5rem;
    font-family: monospace;
    font-size: 0.75rem;
  }
  .quote-text {
    font-style: italic;
    color: var(--ink-soft);
    line-height: 1.6;
    margin: 0;
    font-size: 1rem;
  }
  .quote-author {
    color: var(--accent-hover);
    font-family: monospace;
    font-size: 0.9rem;
    margin: 0 0 0.1rem;
  }
  .quote-title {
    color: var(--ink-soft);
    font-family: monospace;
    font-size: 0.8rem;
    margin: 0 0 0.1rem;
  }
  .quote-company {
    color: var(--ink-faint);
    font-family: monospace;
    font-size: 0.8rem;
    margin: 0;
  }
  .carousel-btn {
    background: transparent;
    border: 1px solid var(--border);
    color: var(--accent-hover);
    font-size: 1rem;
    padding: 0.25rem 0.5rem;
    cursor: pointer;
    transition: all 0.2s;
    line-height: 1;
  }
  .carousel-btn:hover {
    border-color: var(--accent);
    box-shadow: 0 2px 8px oklch(62% 0.19 150 / 0.3);
  }
  .carousel-dots {
    display: flex;
    justify-content: center;
    gap: 0.5rem;
    margin-top: 1rem;
  }
  .quote-translated {
    text-align: center;
    font-family: monospace;
    font-size: 0.75rem;
    font-style: italic;
    color: var(--ink-faint);
    margin-top: 0.75rem;
  }
  .carousel-dot {
    width: 8px;
    height: 8px;
    border: 1px solid var(--border);
    background: transparent;
    cursor: pointer;
    transition: all 0.2s;
  }
  .carousel-dot.active {
    background: var(--accent);
    border-color: var(--accent);
    box-shadow: 0 0 6px oklch(62% 0.19 150 / 0.5);
  }
</style>
