---
import SectionHeading from '../ui/SectionHeading.astro';
import { temoignages } from '../../data/temoignages';
import { t } from '../../i18n/ui';
import type { Lang } from '../../i18n/utils';

export interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const d = t(lang);
---

<section id="temoignages" class="home-section py-20 md:py-28" style="background: var(--surface-muted);">
  <div class="container-wide">
    <div class="carousel" data-current="0">
      <div class="carousel-header">
        <SectionHeading kicker={d['testimonials.title']} title={d['home.testimonialsTitle']} />
        <div class="carousel-nav">
          <button type="button" class="carousel-btn prev" aria-label={d['testimonials.prev']}><span aria-hidden="true">←</span></button>
          <button type="button" class="carousel-btn next" aria-label={d['testimonials.next']}><span aria-hidden="true">→</span></button>
        </div>
      </div>
      <div class="carousel-track">
        {temoignages[lang].map((item, i) => (
          <figure class="carousel-slide" data-index={i}>
            <div class="quote-box">
              <blockquote class="quote-collapse" data-expanded="false">
                <p class="quote-text">« {item.quote} »</p>
                <div class="quote-fade"></div>
              </blockquote>
              <button type="button" class="quote-toggle" aria-label={d['testimonials.moreAria']} data-more={d['testimonials.more']} data-less={d['testimonials.less']}>{d['testimonials.more']}</button>
            </div>
            <figcaption>
              <p class="quote-author">{item.name}</p>
              <p class="quote-title">{item.title} · {item.company}</p>
            </figcaption>
          </figure>
        ))}
      </div>

      <div class="carousel-dots" aria-hidden="true">
        {temoignages[lang].map((_, i) => (
          <span class="carousel-dot" data-index={i}></span>
        ))}
      </div>
      {d['testimonials.translated'] && (
        <p class="quote-translated">{d['testimonials.translated']}</p>
      )}
    </div>
  </div>
</section>

<script>
  // Partagé avec le dépliage des citations, qui met la rotation en pause.
  let interval: ReturnType<typeof setInterval> | undefined;
  const carousel = document.querySelector('.carousel') as HTMLElement | null;
  if (carousel) {
    const track = carousel.querySelector('.carousel-track') as HTMLElement;
    const slides = track.querySelectorAll('.carousel-slide');
    const dots = carousel.querySelectorAll('.carousel-dot');
    const prev = carousel.querySelector('.prev') as HTMLElement;
    const next = carousel.querySelector('.next') as HTMLElement;
    let current = 0;

    function goTo(index: number) {
      current = index;
      track.style.transform = `translateX(-${current * 100}%)`;
      carousel.setAttribute('data-current', String(current));
      dots.forEach((d, i) => d.classList.toggle('active', i === current));
    }

    function nextSlide() { goTo((current + 1) % slides.length); }
    function prevSlide() { goTo((current - 1 + slides.length) % slides.length); }

    prev.addEventListener('click', () => { prevSlide(); resetAuto(); });
    next.addEventListener('click', () => { nextSlide(); resetAuto(); });
    dots.forEach(d => d.addEventListener('click', () => { goTo(Number((d as HTMLElement).dataset.index)); resetAuto(); }));

    carousel.addEventListener('mouseenter', () => clearInterval(interval));
    carousel.addEventListener('mouseleave', resetAuto);

    // Pas de défilement automatique quand le visiteur refuse les animations.
    const sansAnimation = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    function resetAuto() {
      clearInterval(interval);
      if (!sansAnimation) interval = setInterval(nextSlide, 8000);
    }

    goTo(0);
    resetAuto();
  }

  // Quote collapse toggle — pause auto-rotation
  document.querySelectorAll('.quote-toggle').forEach(btn => {
    btn.addEventListener('click', () => {
      const collapse = btn.previousElementSibling as HTMLElement;
      const expanded = collapse.dataset.expanded === 'true';
      collapse.dataset.expanded = expanded ? 'false' : 'true';
      const b = btn as HTMLElement;
      b.textContent = (expanded ? b.dataset.more : b.dataset.less) ?? '';
      // pause auto-rotation when expanded
      if (!expanded) clearInterval(interval);
    });
  });
</script>

<style>
  .carousel {
    position: relative;
    overflow: hidden;
  }
  .carousel-header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.5rem;
    margin-bottom: 2rem;
  }
  .carousel-nav {
    display: flex;
    flex-shrink: 0;
    gap: 0.5rem;
  }
  .carousel-track {
    display: flex;
    transition: transform 0.4s ease;
  }
  .carousel-slide {
    min-width: 100%;
    box-sizing: border-box;
    margin: 0;
    padding: 0 0.25rem;
  }
  .quote-box {
    max-width: 48rem;
    margin: 0 0 1.25rem;
    padding: 1.75rem 1.75rem 1rem;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--card-bg);
  }
  .quote-collapse {
    position: relative;
    margin: 0;
    max-height: 7.5em;
    overflow: hidden;
  }
  .quote-collapse[data-expanded="true"] {
    max-height: none;
  }
  .quote-text {
    margin: 0;
    font-size: 1.125rem;
    line-height: 1.65;
    color: var(--ink);
  }
  .quote-fade {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 2.5em;
    background: linear-gradient(transparent, var(--card-bg));
    pointer-events: none;
  }
  .quote-collapse[data-expanded="true"] .quote-fade {
    display: none;
  }
  .quote-toggle {
    display: inline-block;
    min-height: 44px;
    margin-top: 0.25rem;
    padding: 0;
    background: none;
    border: none;
    color: var(--accent-hover);
    font-family: var(--font-mono);
    font-size: 0.875rem;
    text-decoration: underline;
    text-underline-offset: 3px;
    cursor: pointer;
  }
  .quote-author {
    margin: 0 0 0.15rem;
    font-weight: 700;
    color: var(--ink);
  }
  .quote-title {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--ink-soft);
  }
  .carousel-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    background: transparent;
    border: 1.5px solid var(--ink);
    border-radius: 4px;
    color: var(--ink);
    font-size: 1.125rem;
    cursor: pointer;
    transition: background-color 0.15s ease, color 0.15s ease;
  }
  .carousel-btn:hover {
    background: var(--ink);
    color: #fff;
  }
  .carousel-btn:focus-visible,
  .quote-toggle:focus-visible {
    outline: 2px solid var(--accent-hover);
    outline-offset: 3px;
  }
  .carousel-dots {
    display: flex;
    gap: 0.5rem;
    margin-top: 1.25rem;
  }
  .carousel-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--border);
    cursor: pointer;
  }
  .carousel-dot.active {
    background: var(--ink);
  }
  .quote-translated {
    margin-top: 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-style: italic;
    color: var(--ink-faint);
  }
  @media (max-width: 639px) {
    .carousel-header {
      flex-direction: column;
      align-items: flex-start;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .carousel-track,
    .carousel-btn {
      transition: none;
    }
  }
</style>
