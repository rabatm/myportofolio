---
import { parcours } from '../../data/parcours';
---

<section id="parcours" class="px-4 py-20 max-w-3xl mx-auto">
  <h2 class="section-title">Parcours</h2>
  <div class="space-y-6">
    {parcours.map(entry => (
      <div class="card">
        <p class="text-sm font-mono mb-3" style="color: #00fff7;">
          ── {entry.periode} ──
        </p>
        <h3 class="font-bold text-lg" style="color: #f0f0f0;">
          ▌ {entry.titre}
        </h3>
        {entry.entreprise && (
          <p class="text-sm font-mono mb-2" style="color: #888;">
            {entry.entreprise}
          </p>
        )}
        <p class="text-sm leading-relaxed" style="color: #aaa;">
          {entry.desc}
        </p>
      </div>
    ))}
  </div>
</section>
