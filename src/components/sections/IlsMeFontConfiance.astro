---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import { companies } from '../../data/companies';
import { t } from '../../i18n/ui';
import type { Lang } from '../../i18n/utils';

export interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const d = t(lang);
const liste = companies[lang];

// Logos optimisés au build ; companies.ts ne connaît que le nom du fichier.
const logos = import.meta.glob<ImageMetadata>('../../assets/logos/*', { eager: true, import: 'default' });
function logo(fichier: string): ImageMetadata {
  const trouve = logos[`../../assets/logos/${fichier}`];
  if (!trouve) throw new Error(`Logo introuvable dans src/assets/logos/ : ${fichier}`);
  return trouve;
}
---

<section id="confiance" class="px-4 py-20 max-w-3xl mx-auto">
  <h2 class="section-title">{d['trust.title']}</h2>
  <p class="text-center text-sm mb-10 -mt-6" style="color: var(--ink-soft);">
    {d['trust.subtitle']}
  </p>

  <div class="trust-row">
    {liste.map((c, i) => (
      <>
        {i > 0 && <span class="trust-sep">│</span>}
        <a href={c.url} target="_blank" rel="noopener noreferrer" class="trust-item">
          <div class="trust-frame">
            <Image
              src={logo(c.logo)}
              alt={c.name}
              width={280}
              format="webp"
              loading="lazy"
              decoding="async"
              class="trust-logo"
              style={c.logoBg === 'white' ? 'background: #fff; padding: 6px; border-radius: 4px;' : 'background: #1a1a1a; padding: 6px; border-radius: 4px;'}
            />
          </div>
          <span class="trust-name">{c.name}</span>
          <span class="trust-desc">{c.tagline}</span>
        </a>
      </>
    ))}
  </div>
</section>

<style>
  .trust-row {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0;
    flex-wrap: wrap;
  }
  .trust-sep {
    color: var(--border);
    font-size: 2rem;
    font-family: monospace;
  }
  .trust-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    padding: 1.5rem 1rem;
    text-decoration: none;
    transition: all 0.2s;
    width: 180px;
  }
  .trust-item:hover {
    background: var(--accent-soft);
    border-radius: 16px;
  }
  .trust-frame {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 64px;
    width: 140px;
    transition: all 0.2s;
  }
  .trust-item:hover .trust-frame {
    filter: drop-shadow(0 2px 6px oklch(62% 0.19 150 / 0.3));
  }
  .trust-logo {
    max-width: 100%;
    max-height: 54px;
    object-fit: contain;
    filter: grayscale(0.4);
    opacity: 0.75;
    transition: all 0.2s;
  }
  .trust-item:hover .trust-logo {
    filter: grayscale(0);
    opacity: 1;
  }
  .trust-name {
    font-family: monospace;
    font-size: 0.9rem;
    color: var(--accent-hover);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .trust-desc {
    font-family: monospace;
    font-size: 0.75rem;
    color: var(--ink-faint);
    text-align: center;
    line-height: 1.3;
  }
  .trust-item:hover .trust-desc {
    color: var(--ink-soft);
  }

  @media (max-width: 768px) {
    .trust-sep {
      display: none;
    }
    .trust-item {
      width: 100%;
      max-width: 260px;
      padding: 1rem;
    }
    .trust-row {
      flex-direction: column;
      gap: 1rem;
    }
  }
</style>
