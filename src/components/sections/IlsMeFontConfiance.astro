---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import { companies } from '../../data/companies';
import { t } from '../../i18n/ui';
import type { Lang } from '../../i18n/utils';

export interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const d = t(lang);
const liste = companies[lang];

// Logos optimisés au build ; companies.ts ne connaît que le nom du fichier.
const logos = import.meta.glob<ImageMetadata>('../../assets/logos/*', { eager: true, import: 'default' });
function logo(fichier: string): ImageMetadata {
  const trouve = logos[`../../assets/logos/${fichier}`];
  if (!trouve) throw new Error(`Logo introuvable dans src/assets/logos/ : ${fichier}`);
  return trouve;
}
---

<section id="clients" class="home-section py-12" style="border-block: 1px solid var(--border);" aria-labelledby="clients-titre">
  <div class="container-wide clients-band">
    <h2 id="clients-titre" class="kicker clients-title">{d['home.clientsTitle']}</h2>
    <ul class="clients-row">
      {liste.map((c) => (
        <li>
          <a href={c.url} target="_blank" rel="noopener noreferrer" class="client-link">
            <Image
              src={logo(c.logo)}
              alt={c.name}
              width={280}
              format="webp"
              loading="lazy"
              decoding="async"
              class:list={['client-logo', c.logoBg === 'dark' && 'client-logo--dark']}
            />
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .clients-band {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    align-items: center;
  }
  @media (min-width: 1024px) {
    .clients-band {
      flex-direction: row;
      justify-content: space-between;
    }
  }
  .clients-title {
    margin: 0;
    text-align: center;
  }
  .clients-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 1.5rem 2.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .client-link {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    border-radius: 4px;
  }
  .client-link:focus-visible {
    outline: 2px solid var(--accent-hover);
    outline-offset: 4px;
  }
  .client-logo {
    display: block;
    width: auto;
    max-width: 140px;
    height: 48px;
    object-fit: contain;
    padding: 6px;
    border-radius: 4px;
    background: #fff;
    filter: grayscale(1);
    opacity: 0.8;
    transition: filter 0.2s ease, opacity 0.2s ease;
  }
  /* Logos clairs : ils gardent leur cadre sombre pour rester lisibles. */
  .client-logo--dark {
    background: #1a1a1a;
  }
  .client-link:hover .client-logo,
  .client-link:focus-visible .client-logo {
    filter: none;
    opacity: 1;
  }
  @media (prefers-reduced-motion: reduce) {
    .client-logo {
      transition: none;
    }
  }
</style>
