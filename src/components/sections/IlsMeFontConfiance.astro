---
const companies = [
  {
    name: 'Amopi',
    url: 'https://amopi.fr',
    logo: '/amopi.png',
    bgWhite: true,
    desc: "Transformation numérique & cloud",
  },
  {
    name: 'JurisPerform',
    url: 'https://jurisperform.fr',
    logo: '/jurisperform.png',
    bgWhite: true,
    desc: 'Conseil & formation pour le droit',
  },
  {
    name: 'Surikwat',
    url: 'https://surikwat.com',
    logo: '/surikwat.png',
    bgDark: true,
    desc: 'Studio créatif web & print',
  },
];
---

<section id="confiance" class="px-4 py-20 max-w-3xl mx-auto">
  <h2 class="section-title">Ils me font confiance</h2>
  <p class="text-center text-sm mb-10 -mt-6" style="color: var(--ink-soft);">
    Des entreprises qui m'ont confié leurs systèmes en production.
  </p>

  <div class="trust-row">
    {companies.map((c, i) => (
      <>
        {i > 0 && <span class="trust-sep">│</span>}
        <a href={c.url} target="_blank" rel="noopener noreferrer" class="trust-item">
          <div class="trust-frame">
            <img
              src={c.logo}
              alt={c.name}
              class="trust-logo"
              style={c.bgWhite ? 'background: #fff; padding: 6px; border-radius: 4px;' : c.bgDark ? 'background: #1a1a1a; padding: 6px; border-radius: 4px;' : ''}
            />
          </div>
          <span class="trust-name">{c.name}</span>
          <span class="trust-desc">{c.desc}</span>
        </a>
      </>
    ))}
  </div>
</section>

<style>
  .trust-row {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0;
    flex-wrap: wrap;
  }
  .trust-sep {
    color: var(--border);
    font-size: 2rem;
    font-family: monospace;
  }
  .trust-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    padding: 1.5rem 1rem;
    text-decoration: none;
    transition: all 0.2s;
    width: 180px;
  }
  .trust-item:hover {
    background: var(--accent-soft);
    border-radius: 16px;
  }
  .trust-frame {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 64px;
    width: 140px;
    transition: all 0.2s;
  }
  .trust-item:hover .trust-frame {
    filter: drop-shadow(0 2px 6px oklch(62% 0.19 150 / 0.3));
  }
  .trust-logo {
    max-width: 100%;
    max-height: 54px;
    object-fit: contain;
    filter: grayscale(0.4);
    opacity: 0.75;
    transition: all 0.2s;
  }
  .trust-item:hover .trust-logo {
    filter: grayscale(0);
    opacity: 1;
  }
  .trust-name {
    font-family: monospace;
    font-size: 0.9rem;
    color: var(--accent-hover);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .trust-desc {
    font-family: monospace;
    font-size: 0.75rem;
    color: var(--ink-faint);
    text-align: center;
    line-height: 1.3;
  }
  .trust-item:hover .trust-desc {
    color: var(--ink-soft);
  }

  @media (max-width: 768px) {
    .trust-sep {
      display: none;
    }
    .trust-item {
      width: 100%;
      max-width: 260px;
      padding: 1rem;
    }
    .trust-row {
      flex-direction: column;
      gap: 1rem;
    }
  }
</style>
