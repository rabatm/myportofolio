---
const companies = [
  {
    name: 'Amopi',
    url: 'https://amopi.fr',
    logo: '/amopi.png',
    bgWhite: true,
    desc: "Accompagne la transformation numérique des entreprises, de l'intégration de logiciels de gestion à l'hébergement cloud.",
  },
  {
    name: 'JurisPerform',
    url: 'https://jurisperform.fr',
    logo: '/jurisperform.png',
    bgWhite: true,
    desc: 'Cabinet de conseil et organisme de formation dédié aux professionnels du droit (avocats, notaires, commissaires de justice).',
  },
  {
    name: 'Surikwat',
    url: 'https://surikwat.com',
    logo: '/surikwat.png',
    desc: 'Studio créatif de communication web et print, spécialisé dans les sites sur mesure, le design graphique et l\'audiovisuel.',
  },
];
---

<section class="px-4 py-20 max-w-4xl mx-auto">
  <h2 class="section-title">Ils me font confiance</h2>
  <div class="flex flex-wrap justify-center gap-8 md:gap-16">
    {companies.map((c) => (
      <a href={c.url} target="_blank" rel="noopener noreferrer" class="trust-card">
        <div class="trust-card-inner">
          <div class="trust-logo-wrap">
            <img
              src={c.logo}
              alt={c.name}
              class="trust-logo"
              style={c.bgWhite ? 'background: #fff; padding: 8px; border-radius: 4px;' : ''}
            />
          </div>
          <p class="trust-desc">{c.desc}</p>
        </div>
      </a>
    ))}
  </div>
</section>

<style>
  .trust-card {
    display: flex;
    align-items: stretch;
    justify-content: center;
    width: 280px;
    border: 1px solid #333;
    background: rgba(255, 255, 255, 0.02);
    transition: all 0.2s;
    text-decoration: none;
    padding: 1rem;
  }
  .trust-card:hover {
    border-color: #00fff7;
    box-shadow: 0 0 16px rgba(0, 255, 247, 0.15);
  }
  .trust-card-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
  }
  .trust-logo-wrap {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 64px;
  }
  .trust-logo {
    max-width: 100%;
    max-height: 56px;
    object-fit: contain;
    filter: grayscale(0.3);
    opacity: 0.8;
    transition: all 0.2s;
  }
  .trust-card:hover .trust-logo {
    filter: grayscale(0);
    opacity: 1;
  }
  .trust-desc {
    margin: 0;
    font-size: 0.8rem;
    color: #888;
    line-height: 1.4;
    text-align: center;
  }
</style>
