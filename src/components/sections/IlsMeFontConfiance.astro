---
const companies = [
  {
    name: 'Amopi',
    url: 'https://amopi.fr',
    logo: '/amopi.png',
    bgWhite: true,
  },
  {
    name: 'JurisPerform',
    url: 'https://jurisperform.fr',
    logo: '/jurisperform.png',
    bgWhite: true,
  },
  {
    name: 'Surikwat',
    url: 'https://surikwat.com',
    logo: '/surikwat.png',
  },
];
---

<section class="px-4 py-20 max-w-4xl mx-auto">
  <h2 class="section-title">Ils me font confiance</h2>
  <div class="flex flex-wrap justify-center gap-8 md:gap-16">
    {companies.map((c) => (
      <a href={c.url} target="_blank" rel="noopener noreferrer" class="trust-card">
        {c.logo ? (
          <img
            src={c.logo}
            alt={c.name}
            class="trust-logo"
            style={c.bgWhite ? 'background: #fff; padding: 8px; border-radius: 4px;' : ''}
          />
        ) : (
          <span class="trust-initials">{c.initials}</span>
        )}
      </a>
    ))}
  </div>
</section>

<style>
  .trust-card {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 180px;
    height: 100px;
    border: 1px solid #333;
    background: rgba(255, 255, 255, 0.02);
    transition: all 0.2s;
    text-decoration: none;
  }
  .trust-card:hover {
    border-color: #00fff7;
    box-shadow: 0 0 16px rgba(0, 255, 247, 0.15);
  }
  .trust-logo {
    max-width: 80%;
    max-height: 60px;
    object-fit: contain;
    filter: grayscale(0.3);
    opacity: 0.8;
    transition: all 0.2s;
  }
  .trust-card:hover .trust-logo {
    filter: grayscale(0);
    opacity: 1;
  }
  .trust-initials {
    font-size: 1.8rem;
    font-weight: 700;
    font-family: monospace;
    color: #555;
    letter-spacing: 0.2em;
    transition: color 0.2s;
  }
  .trust-card:hover .trust-initials {
    color: #00fff7;
  }
</style>
