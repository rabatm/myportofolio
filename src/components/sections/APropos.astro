---
import { Picture } from 'astro:assets';
import martin from '../../assets/martin.png';
import { t } from '../../i18n/ui';
import type { Lang } from '../../i18n/utils';

export interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const d = t(lang);
---

<section id="apropos" class="px-4 py-20 max-w-3xl mx-auto">
  <h2 class="section-title">{d['about.title']}</h2>
  <div class="flex flex-col md:flex-row gap-8 items-start">
    <div class="w-32 h-32 shrink-0 retro-border rounded-full overflow-hidden">
      <Picture src={martin} alt="Martin Rabat" widths={[128, 256]} sizes="128px" formats={['avif']} fallbackFormat="webp" loading="lazy" decoding="async" class="w-full h-full object-cover" style="object-position: center 15%;" />
    </div>
    <div>
      <p class="mb-4 italic leading-relaxed" style="color: var(--ink);">
        {d['about.quote']}
      </p>
      <p class="mb-4 leading-relaxed" style="color: var(--ink-soft);">
        {d['about.p1']}
      </p>
      <p class="leading-relaxed" style="color: var(--ink-soft);">
        {d['about.p2']}
      </p>
      <p class="mb-4 leading-relaxed" style="color: var(--ink-soft);">
        {d['about.p3']}
      </p>
    </div>
  </div>
</section>
