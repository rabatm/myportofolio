---
import { CONTACT_EMAIL } from '../../data/site';
import { services } from '../../data/services';
import { t } from '../../i18n/ui';
import { fmt, type Lang } from '../../i18n/utils';

export interface Props {
  lang: Lang;
  /** Préfixe des `id` des champs : deux formulaires sur une page ne se marchent pas dessus. */
  idPrefix: string;
}

const { lang, idPrefix } = Astro.props;
const d = t(lang);
const id = (champ: string) => `${idPrefix}-${champ}`;

// Lignes « libellé....... OK » : les points complètent jusqu'à une largeur fixe
// pour que les OK restent alignés, quelle que soit la langue.
const LARGEUR = 28;
const etape = (libelle: string) => `> ${libelle} `.padEnd(LARGEUR + 3, '.') + ' OK';
---

<div class="contact-form" data-contact-form>
  <form
    class="contact-fields"
    data-contact-fields
    data-sending={d['contact.sending']}
    data-error={fmt(d['contact.error'], { email: CONTACT_EMAIL })}
  >
    <input type="hidden" name="lang" value={lang} />
    <!-- Piège à robots : invisible et hors tabulation, un humain le laisse vide. -->
    <input type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" style="position: absolute; left: -9999px;" />

    <div class="field">
      <label for={id('name')}>{d['contact.name']}</label>
      <input id={id('name')} type="text" name="name" required maxlength="100" autocomplete="name" />
    </div>
    <div class="field">
      <label for={id('company')}>
        {d['contact.company']} <span class="field__optional">({d['contact.optional']})</span>
      </label>
      <input id={id('company')} type="text" name="company" maxlength="100" autocomplete="organization" />
    </div>
    <div class="field">
      <label for={id('email')}>{d['contact.email']}</label>
      <input id={id('email')} type="email" name="email" required maxlength="200" autocomplete="email" />
    </div>
    <div class="field">
      <label for={id('projectType')}>
        {d['contact.projectType']} <span class="field__optional">({d['contact.optional']})</span>
      </label>
      <select id={id('projectType')} name="projectType">
        <option value="">{d['contact.projectTypeChoose']}</option>
        {services[lang].map((s) => <option value={s.id}>{s.name}</option>)}
        <option value="other">{d['contact.projectTypeOther']}</option>
      </select>
    </div>
    <div class="field field--full">
      <label for={id('message')}>{d['contact.message']}</label>
      <textarea id={id('message')} name="message" required rows="5" maxlength="5000"></textarea>
    </div>
    <div class="field--full">
      <button type="submit" class="btn-primary w-full sm:w-auto">{d['contact.submit']}</button>
    </div>
    <p class="contact-status field--full" role="alert" data-contact-status></p>
  </form>

  <!-- Séquence affichée à la place du formulaire une fois le message parti. -->
  <div class="contact-done" hidden data-contact-done data-thanks={d['contact.done.thanks']}>
    <p class="contact-done__line">{etape(d['contact.done.connect'])}</p>
    <p class="contact-done__line">{etape(d['contact.done.tls'])}</p>
    <p class="contact-done__line">
      &gt; {d['contact.done.progress']} [<span class="contact-done__bar" data-bar></span>] <span data-pct>0%</span>
    </p>
    <p class="contact-done__line contact-done__sent">&gt; {d['contact.done.sent']}</p>
    <p class="contact-done__line contact-done__thanks" data-thanks-line></p>
    <p class="contact-done__line contact-done__signature">— Martin</p>
    <button type="button" class="contact-done__line btn-primary font-mono contact-done__again">
      {d['contact.done.again']}
    </button>
    <p class="sr-only" aria-live="polite" data-announce></p>
  </div>
</div>

<script>
  const PAUSE_LIGNE_MS = 350;
  const LARGEUR_BARRE = 12;
  const attendre = (ms: number) => new Promise((r) => setTimeout(r, ms));

  /** Chaque instance est autonome : tout est cherché dans sa propre racine. */
  function brancher(racine: HTMLElement) {
    const f = racine.querySelector<HTMLFormElement>('[data-contact-fields]');
    const status = racine.querySelector<HTMLElement>('[data-contact-status]');
    const done = racine.querySelector<HTMLElement>('[data-contact-done]');
    if (!f || !status || !done) return;

    const button = f.querySelector('button[type="submit"]') as HTMLButtonElement;
    const initialLabel = button.textContent;
    const lignes = Array.from(done.querySelectorAll<HTMLElement>('.contact-done__line'));
    const barre = done.querySelector<HTMLElement>('[data-bar]')!;
    const pct = done.querySelector<HTMLElement>('[data-pct]')!;
    const merci = done.querySelector<HTMLElement>('[data-thanks-line]')!;
    const annonce = done.querySelector<HTMLElement>('[data-announce]')!;
    const encore = done.querySelector<HTMLButtonElement>('.contact-done__again')!;
    // Temps passé sur le formulaire, envoyé comme durée : l'API rejette
    // silencieusement les envois trop rapides pour être humains.
    const affiche = performance.now();

    function remplirBarre(n: number) {
      barre.textContent = '█'.repeat(n) + ' '.repeat(LARGEUR_BARRE - n);
      pct.textContent = `${Math.round((n / LARGEUR_BARRE) * 100)}%`;
    }

    /** Remplace le formulaire par la séquence de transmission, ligne à ligne. */
    async function montrerSucces(nom: string) {
      // textContent : le nom saisi n'est jamais interprété comme du HTML.
      merci.textContent = (done!.dataset.thanks ?? '').replace('{name}', nom);
      remplirBarre(0);
      const sansAnimation = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      if (!sansAnimation) {
        f!.classList.add('contact-form--leaving');
        await attendre(250);
      }
      f!.hidden = true;
      f!.classList.remove('contact-form--leaving');
      done!.hidden = false;

      for (const ligne of lignes) {
        ligne.classList.add('is-visible');
        if (sansAnimation) continue;
        if (ligne.contains(barre)) {
          for (let n = 1; n <= LARGEUR_BARRE; n++) {
            remplirBarre(n);
            await attendre(n % 4 === 0 ? 180 : 45);
          }
        }
        await attendre(PAUSE_LIGNE_MS);
      }
      remplirBarre(LARGEUR_BARRE);

      // Une seule annonce, à la fin, plutôt qu'une par ligne.
      annonce.textContent = `${lignes.find((l) => l.classList.contains('contact-done__sent'))?.textContent?.trim()} ${merci.textContent}`;
      encore.focus();
    }

    encore.addEventListener('click', () => {
      done.hidden = true;
      lignes.forEach((l) => l.classList.remove('is-visible'));
      annonce.textContent = '';
      f.hidden = false;
      f.querySelector<HTMLInputElement>('input[name="name"]')?.focus();
    });

    f.addEventListener('submit', async (e) => {
      e.preventDefault();
      button.disabled = true;
      button.textContent = f.dataset.sending ?? '';
      status.textContent = '';

      const data = {
        ...Object.fromEntries(new FormData(f)),
        elapsedMs: Math.round(performance.now() - affiche),
      };

      let envoye = false;
      try {
        const res = await fetch('/api/contact', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data),
        });
        if (!res.ok) throw new Error('request failed');
        envoye = true;
      } catch {
        status.textContent = f.dataset.error ?? '';
      } finally {
        button.disabled = false;
        button.textContent = initialLabel;
      }

      if (envoye) {
        f.reset();
        await montrerSucces(String(data.name ?? '').trim());
      }
    });
  }

  document.querySelectorAll<HTMLElement>('[data-contact-form]').forEach(brancher);
</script>
