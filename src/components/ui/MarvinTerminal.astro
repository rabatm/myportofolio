---
export interface Line {
  who: 'user' | 'marvin';
  text: string;
}

export interface Props {
  /** Échange affiché tel quel : aucun appel au modèle, tout est écrit d'avance. */
  lines: Line[];
  /** Nom accessible du terminal (le contenu reste lisible par les lecteurs d'écran). */
  label: string;
}

const { lines, label } = Astro.props;
---

<figure class="marvin-terminal" aria-label={label}>
  {
    lines.map((l) =>
      l.who === 'user' ? (
        <p class="marvin-terminal__user">
          <span aria-hidden="true">? </span>
          {l.text}
        </p>
      ) : (
        <p>
          <span aria-hidden="true">&gt; </span>
          {l.text}
        </p>
      )
    )
  }
  <span class="marvin-terminal__cursor" aria-hidden="true">_</span>
</figure>
