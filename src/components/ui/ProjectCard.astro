---
import type { LocalizedProject } from '../../i18n/collections';
import { buildPath, type Lang } from '../../i18n/utils';
import { services } from '../../data/services';
import OnlyInBadge from '../i18n/OnlyInBadge.astro';
import ProjectThumb from '../projects/ProjectThumb.astro';

export interface Props {
  item: LocalizedProject;
  /** Langue de la page : libellés des services et lien. */
  lang: Lang;
  variant?: 'default' | 'compact';
}

const { item, lang, variant = 'default' } = Astro.props;
const { entry, slug, isFallback, contentLang } = item;
const p = entry.data;

// Libellés dans la langue de la page, même quand le contenu est un repli.
const libelles = p.services
  .map((id) => services[lang].find((s) => s.id === id)?.name)
  .filter((n): n is string => Boolean(n));
---

<a
  href={buildPath('projects', lang, slug)}
  class:list={['project-card', variant === 'compact' && 'project-card--compact']}
  data-services={p.services.join(' ')}
>
  <ProjectThumb image={p.image} title={p.title} alt="" />
  {isFallback && <OnlyInBadge lang={lang} />}
  <h3 class="project-card__title" lang={contentLang}>{p.title}</h3>
  <p class="project-card__desc" lang={contentLang}>{p.description}</p>
  {libelles.length > 0 && <p class="project-card__services">{libelles.join(' · ')}</p>}
</a>
