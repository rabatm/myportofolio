---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/sections/Hero.astro';
import APropos from '../components/sections/APropos.astro';
import Parcours from '../components/sections/Parcours.astro';
import Skills from '../components/sections/Skills.astro';
import ApercuProjets from '../components/sections/ApercuProjets.astro';
import IlsMeFontConfiance from '../components/sections/IlsMeFontConfiance.astro';
import Temoignages from '../components/sections/Temoignages.astro';
import { getCollection } from 'astro:content';
import { pageLines, sectionLines } from '../data/marvinLines';

const projects = await getCollection('projects');
---

<BaseLayout
  title="Martin Rabat — Développeur concepteur d'applications"
  description="Développeur fullstack & DevOps indépendant : applications métier, intégration de systèmes et reprise de legacy. Django, React, Flutter, Docker. 20 ans d'infrastructure derrière moi. Perpignan, full remote."
  peekLines={pageLines['/']}
  sectionLines={sectionLines}
>
  <Hero />
  <APropos />
  <Skills />
  <IlsMeFontConfiance />
  <Temoignages />
  <Parcours />
  <ApercuProjets projects={projects} />
</BaseLayout>
